# CricPoints Arena — environment variables (copy to .env.local)
# With NO variables set, the app runs in fully-local Demo Mode.

# Live match data (server-side only). Free key: https://cricapi.com
CRICAPI_KEY=

# Supabase mode (leave empty for Demo Mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated admin emails for Supabase mode, e.g. you@example.com
NEXT_PUBLIC_ADMIN_EMAILS=
ADMIN_EMAILS=
